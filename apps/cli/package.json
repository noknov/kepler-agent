    "buffer": "^6.0.3",
    "chalk": "^5.4.1",
    "cli-boxes": "^4.0.1",
    "code-excerpt": "^4.0.0",
    "emoji-regex": "^10.4.0",
    "execa": "^10.0.1",
    "figures": "^6.1.0",
    "get-east-asian-width": "^1.3.0",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.17.21",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "semver": "^7.7.1",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^3.2.0",

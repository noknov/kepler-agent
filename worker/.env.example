# Kepler Agent Worker
# Used by: go run ./worker/cmd/worker

# Slack API client and event payload filtering.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_ID=
SLACK_ATTRIBUTION_NAME=斗包
# SLACK_REPLY_FOOTER=Sent using <@U0AKAMGBB26|斗包>
SLACK_DEFAULT_LOCALE=en-US
ALLOWED_SLACK_USERS=U11111111,U22222222
ALLOWED_SLACK_CHANNELS=

# Durable state and pub/sub.
POSTGRES_DSN=postgres://kepler_agent:kepler_agent@localhost:5432/kepler_agent?sslmode=disable
REDIS_URL=redis://localhost:6379/0
POSTGRES_MAX_CONNS=8

# Slack inbox consumer controls.
SLACK_EVENT_WORKERS=8
SLACK_EVENT_QUEUE_SIZE=512
SLACK_EVENT_TIMEOUT=15m
SLACK_EVENT_INBOX_LEASE=16m
SLACK_EVENT_MAX_ATTEMPTS=5
SLACK_EVENT_RETRY_BASE=1s
SLACK_EVENT_RETRY_MAX=1m
HTTP_SHUTDOWN_TIMEOUT=90s

# Agent model runtime.
LLM_PROVIDER=longcat
LLM_PROTOCOL=
LLM_ANTHROPIC_FLAVOR=
LONGCAT_API_KEY=Bearer lc-...
LONGCAT_BASE_URL=https://api.longcat.chat/anthropic
LONGCAT_MODEL=LongCat-2.0
LONGCAT_PROTOCOL=anthropic
LONGCAT_TIMEOUT=120s

# Alternate providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5
MIMO_PROTOCOL=anthropic
MIMO_THINKING=disabled
MIMO_TEMPERATURE=0
MIMO_TIMEOUT=120s
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
KIMI_THINKING=disabled
KIMI_TEMPERATURE=0
KIMI_TIMEOUT=120s
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=mimo-v2.5-free
OPENCODE_ZEN_PROTOCOL=openai
OPENCODE_ZEN_TEMPERATURE=0
OPENCODE_ZEN_TIMEOUT=120s
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.2
OPENCODE_GO_PROTOCOL=responses
# Reasoning models such as gpt-5.6-luna reject temperature on /responses.
# OPENCODE_GO_TEMPERATURE=
OPENCODE_GO_TIMEOUT=300s
CLIPROXYAPI_API_KEY=
CLIPROXYAPI_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXYAPI_MODEL=kimi/kimi-k2.7-code
CLIPROXYAPI_PROTOCOL=openai
CLIPROXYAPI_THINKING=
CLIPROXYAPI_TEMPERATURE=0
CLIPROXYAPI_TIMEOUT=120s
API_TIMEOUT_MS=120000
MODEL_ROUTING_MULTIMODAL_MODEL=
MULTIMODAL_MODELS=

# Optional secondary model for context compaction only.
SECONDARY_PROVIDER=
SECONDARY_MODEL=

# Workspace and tools.
WORKSPACE_ROOTS=/path/to/your/repos
WORKSPACE_AUTO_FETCH=false
TOOL_COMMAND_TIMEOUT=30s
AGENT_MAX_STEPS=256
# Exact server-side authorization for write/external-write tools. Users cannot
# expand this list at runtime.
AGENT_ALLOWED_WRITE_TOOLS=reminder-create,reminder-cancel,slack-create_canvas,slack-user_post_message,tts-speak
PROMPT_DIR=worker/.prompts
GCLOUD_PATH=gcloud
GCP_PROJECT=
GCP_NAMESPACE=
GKE_CLUSTER=
GKE_REGION=
KUBECTL_PATH=kubectl
K8S_DEFAULT_CONTEXT=
K8S_DEFAULT_CLUSTER=
SESSION_MAX_CONTEXT_TOKENS=200000
SESSION_AUTOCOMPACT_BUFFER=13000
SESSION_MAX_TOOL_RESULT_TOKENS=8000
SESSION_COMPACT_MODEL=

# Optional observability cost overrides.
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=
LLM_CACHE_READ_COST_PER_MTOK=
LLM_CACHE_CREATION_COST_PER_MTOK=

# Optional integrations used by tools.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=
# Notion MCP OAuth. Users connect via App Home or kepler-agent connect notion.
# NOTION_MCP_URL=https://mcp.notion.com/mcp
YOUTRACK_URL=
YOUTRACK_TOKEN=
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_SEARXNG_URL=
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_CX=
WEB_SEARCH_SERPAPI_KEY=
WEB_SEARCH_SERPAPI_BASE_URL=https://serpapi.com/search.json
LUCKIN_MCP_URL=https://gwmcp.lkcoffee.com/order/user/mcp
LUCKIN_MCP_TOKEN=
# ClickStack MCP (ClickHouse Cloud): set SERVICE_ID, users connect via App Home OAuth.
# CLICKSTACK_MCP_URL=https://mcp.clickhouse.cloud/clickstack
CLICKSTACK_SERVICE_ID=
CLICKSTACK_TEAM_ID=
# Google Cloud OAuth (read-only). Users connect via App Home or kepler-agent connect gcp.
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=
TTS_API_KEY=
TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts
TTS_DEFAULT_VOICE=冰糖
TTS_DEFAULT_STYLE=

# Optional standard OpenTelemetry OTLP/HTTP trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kepler-agent-worker

# Slack Copilot Observability
# Used by: go run ./observability/cmd/observability

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=30s

# Durable runs, reminders, and health support.
POSTGRES_DSN=postgres://slack_copilot:slack_copilot@localhost:5432/slack_copilot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
POSTGRES_MAX_CONNS=4

# Admin auth for /metrics, /runs, and /health/dashboard.
OBSERVABILITY_TOKEN=
OBSERVABILITY_ALLOW_UNAUTHENTICATED=false

# Tool health probes need workspace/tool defaults, but no Slack bot or LLM key.
WORKSPACE_ROOTS=/path/to/your/repos
GCLOUD_PATH=gcloud
GCP_PROJECT=
GCP_NAMESPACE=
GKE_CLUSTER=
GKE_REGION=
KUBECTL_PATH=kubectl
K8S_DEFAULT_CONTEXT=
K8S_DEFAULT_CLUSTER=
PLAYWRIGHT_MCP_URL=
PLAYWRIGHT_MCP_TOKEN=

# Kepler Agent Gateway
# Used by: go run ./gateway/cmd/gateway

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=30s
SLACK_EVENT_ENQUEUE_TIMEOUT=2s

# Gateway only needs Slack request verification plus durable ingress storage.
SLACK_SIGNING_SECRET=

# Optional. If present, interaction handlers can refresh Slack App Home after
# toggling user preferences. Without it, the preference still updates in Redis.
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
ALLOWED_SLACK_USERS=
ALLOWED_SLACK_CHANNELS=

# CLI Slack login + LLM reverse proxy to the worker.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
CONNECTIONS_PUBLIC_BASE_URL=
WORKER_UPSTREAM_URL=http://127.0.0.1:8081

# Durable event inbox and cross-service notification.
POSTGRES_DSN=postgres://kepler_agent:kepler_agent@localhost:5432/kepler_agent?sslmode=disable
REDIS_URL=redis://localhost:6379/0
POSTGRES_MAX_CONNS=4

# Optional standard OpenTelemetry OTLP/HTTP trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kepler-agent-gateway

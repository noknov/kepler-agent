# Server
HTTP_ADDR=:8080

# Slack HTTP Events API
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_BOT_USER_ID=
ALLOWED_SLACK_USERS=U11111111,U22222222
ALLOWED_SLACK_CHANNELS=

# LLM provider
LLM_PROVIDER=mimo
MIMO_PROTOCOL=anthropic
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5
# Comma-separated list of models users can switch between from the App Home.
# When set, a dropdown appears on the home tab. Omit to disable model switching.
AVAILABLE_MODELS=mimo-v2.5,mimo-v2.5-pro
# Models that support multimodal (image) input. When set, images sent to other
# models are stripped and replaced with a text note prompting for a description.
MULTIMODAL_MODELS=mimo-v2.5
MIMO_THINKING=disabled
# Set this only if you intentionally want shell env vars to disagree with .env.
ALLOW_ENV_MIXING=
# Set this to make .env override conflicting shell provider variables.
PREFER_DOTENV=

# Optional alternate providers.
LLM_PROTOCOL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# For Kimi For Coding / Claude Code-style agents, prefer:
# LLM_PROTOCOL=anthropic
# LLM_ANTHROPIC_FLAVOR=claude-code
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
# ANTHROPIC_MODEL=kimi-for-coding
LLM_ANTHROPIC_FLAVOR=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ALLOW_EXPERIMENTAL_CODING_ENDPOINT=
CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
API_TIMEOUT_MS=120000

MOONSHOT_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
KIMI_THINKING=disabled
MIMO_MAX_TOKENS=8192
MIMO_TEMPERATURE=0.2
MIMO_TIMEOUT=120s
KIMI_MAX_TOKENS=8192
KIMI_TEMPERATURE=0.2
KIMI_TIMEOUT=120s

# Workspace and sessions
WORKSPACE_ROOTS=/Users/shelton/Documents/wati
WORKSPACE_AUTO_FETCH=false
SESSION_DATA_DIR=.data/sessions
SESSION_MAX_MESSAGES=24
SESSION_MAX_TOOL_CHARS=20000
SESSION_MAX_THREAD_CHARS=6000
SESSION_MAX_SUMMARY_CHARS=2500
AGENT_MAX_STEPS=128
TOOL_COMMAND_TIMEOUT=30s
PROMPT_DIR=.prompts

# Observability endpoints (/metrics, /runs). Set OBSERVABILITY_TOKEN and send
# Authorization: Bearer <token> or X-Oncall-Agent-Admin-Token: <token>.
OBSERVABILITY_TOKEN=
# Development-only fallback for direct loopback requests without forwarded headers.
OBSERVABILITY_ALLOW_UNAUTHENTICATED=false

# GCP defaults and hints. Tool calls can override these per request.
GCLOUD_PATH=gcloud
GCP_PROJECT=wati-gke
GCP_NAMESPACE=mt-dev-analytics
GKE_CLUSTER=mt-pubsub
GKE_REGION=asia-southeast1

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_VERSION=2022-06-28

# YouTrack
YOUTRACK_URL=
YOUTRACK_TOKEN=

# GitHub Actions / CI/CD
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# Luckin Coffee MCP. Copy a personal login token from https://open.lkcoffee.com/mcp.
LUCKIN_MCP_URL=https://gwmcp.lkcoffee.com/order/user/mcp
LUCKIN_MCP_TOKEN=

# Web search. google_cse uses Google Custom Search JSON API.
# serpapi supports engines such as google and baidu through WEB_SEARCH_SERPAPI_KEY.
WEB_SEARCH_PROVIDER=google_cse
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_CX=
WEB_SEARCH_SERPAPI_KEY=
WEB_SEARCH_SERPAPI_BASE_URL=https://serpapi.com/search.json

# RAG semantic code search. Requires PostgreSQL with pgvector and an
# OpenAI-compatible embedding API. Start the local database with:
#   docker compose -f docker-compose.rag.yml up -d
RAG_ENABLED=false
RAG_POSTGRES_DSN=postgres://oncall:oncall@localhost:5432/oncall_rag?sslmode=disable
# Embedding provider. Any OpenAI-compatible /v1/embeddings endpoint works.
# Local Ollama:    http://localhost:11434/v1  (model: nomic-embed-text, dims: 768)
# SiliconFlow:     https://api.siliconflow.cn/v1  (model: BAAI/bge-m3, dims: 1024)
# OpenAI:          https://api.openai.com/v1  (model: text-embedding-3-small, dims: 1536)
RAG_EMBEDDING_BASE_URL=http://localhost:11434/v1
RAG_EMBEDDING_API_KEY=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMS=768
# Starts async workspace prewarming; rag-search still queues per-repo indexing on demand.
RAG_BACKGROUND_INDEX=true
RAG_INDEX_INTERVAL=5m

# Server
HTTP_ADDR=:8080
# Bounded async processing for Slack Events API callbacks. A full queue returns
# 503 so Slack retries instead of spawning unlimited goroutines.
SLACK_EVENT_WORKERS=8
SLACK_EVENT_QUEUE_SIZE=512
# How long the callback waits for a queue slot before returning 503 for Slack
# to retry. Keep this below Slack's 3-second acknowledgement target.
SLACK_EVENT_ENQUEUE_TIMEOUT=2s
SLACK_EVENT_TIMEOUT=15m
# Claimed inbox events are retried after this lease expires. Default in code is
# SLACK_EVENT_TIMEOUT + 1m when left unset.
SLACK_EVENT_INBOX_LEASE=16m
# Maximum time to stop HTTP intake and drain in-flight Slack events on SIGTERM.
HTTP_SHUTDOWN_TIMEOUT=30s

# Slack HTTP Events API
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_BOT_USER_ID=
ALLOWED_SLACK_USERS=U11111111,U22222222
ALLOWED_SLACK_CHANNELS=

# LLM provider — main agent uses LongCat 2.0 via OpenAI-compatible protocol.
LLM_PROVIDER=longcat
LONGCAT_API_KEY=Bearer lc-...
LONGCAT_BASE_URL=https://api.longcat.chat/anthropic
LONGCAT_MODEL=LongCat-2.0
LONGCAT_PROTOCOL=anthropic
LONGCAT_TIMEOUT=120s

# Secondary model — used for fast code exploration and compact summaries.
# Credentials (API key, base URL) are shared from the provider's existing env block.
SECONDARY_PROVIDER=deepseek
SECONDARY_MODEL=deepseek-v4-flash

# DeepSeek credentials (shared with secondary model when SECONDARY_PROVIDER=deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiMo — alternative main provider via Anthropic-compatible protocol.
MIMO_PROTOCOL=anthropic
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5
MIMO_THINKING=disabled
MIMO_TEMPERATURE=0
MIMO_TIMEOUT=120s

# Optional capability routing. MULTIMODAL_MODELS declares which models can
# receive image parts. MODEL_ROUTING_MULTIMODAL_MODEL is only a fallback when
# the primary model is not listed there.
MODEL_ROUTING_MULTIMODAL_MODEL=
MULTIMODAL_MODELS=

# Set this only if you intentionally want shell env vars to disagree with .env.
ALLOW_ENV_MIXING=
# Set this to make .env override conflicting shell provider variables.
PREFER_DOTENV=

# Optional alternate providers.
LLM_PROTOCOL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# OpenCode Zen free models. Uses its own namespace so it does not collide with
# the OpenCode Go subscription settings below.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=mimo-v2.5-free
OPENCODE_ZEN_AVAILABLE_MODELS=mimo-v2.5-free,minimax-m3-free,nemotron-3-ultra-free,north-mini-code-free
OPENCODE_ZEN_PROTOCOL=openai
# OpenCode subscription. The app automatically routes selected models to
# the documented /chat/completions or /messages endpoint.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.2
OPENCODE_GO_AVAILABLE_MODELS=glm-5.2,kimi-k2.7-code,mimo-v2.5
OPENCODE_GO_PROTOCOL=openai
# CLIProxyAPI local gateway. Authenticate Kimi/Codex in CLIProxyAPI itself, then
# point this app to its OpenAI-compatible endpoint. Do not put subscription
# cookies or OAuth refresh tokens in this application's .env.
CLIPROXYAPI_API_KEY=
CLIPROXYAPI_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXYAPI_MODEL=kimi/kimi-k2.7-code
CLIPROXYAPI_AVAILABLE_MODELS=kimi/kimi-k2.7-code,codex/gpt-5-codex
CLIPROXYAPI_PROTOCOL=openai
CLIPROXYAPI_THINKING=
CLIPROXYAPI_TEMPERATURE=0
CLIPROXYAPI_TIMEOUT=120s
LLM_ANTHROPIC_FLAVOR=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
API_TIMEOUT_MS=120000

MOONSHOT_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
KIMI_THINKING=disabled
KIMI_TEMPERATURE=0
KIMI_TIMEOUT=120s
OPENCODE_GO_TEMPERATURE=0
OPENCODE_GO_TIMEOUT=120s
OPENCODE_ZEN_TEMPERATURE=0
OPENCODE_ZEN_TIMEOUT=120s
OPENCODE_GO_WORKSPACE_ID=
OPENCODE_GO_AUTH_COOKIE=

# Workspace and sessions
REDIS_URL=redis://localhost:6379/0
WORKSPACE_ROOTS=/path/to/your/repos
WORKSPACE_AUTO_FETCH=false
PROMPT_INCLUDE_REPO_INVENTORY=false
SESSION_DATA_DIR=.data/sessions
SESSION_MAX_TOOL_CHARS=20000
SESSION_MAX_THREAD_CHARS=6000
SESSION_MAX_SUMMARY_CHARS=2500
# Context window token budget. Auto-compact triggers at this minus buffer minus
# output reserve. Raise for models with larger context windows.
SESSION_MAX_CONTEXT_TOKENS=200000
# Reserved token headroom before the 4-layer auto-compact kicks in.
SESSION_AUTOCOMPACT_BUFFER=13000
# Per-tool-result token cap used by compactor Layer 2 (head+tail truncation).
SESSION_MAX_TOOL_RESULT_TOKENS=8000
# Model used for compact summaries (Layer 4). Empty = secondary model, then main.
SESSION_COMPACT_MODEL=
AGENT_MAX_STEPS=256
# Shared ceiling for active Slack and Web agent runs. Excess requests wait for
# capacity and are still subject to their request timeout.
AGENT_MAX_CONCURRENT_RUNS=16
TOOL_COMMAND_TIMEOUT=30s
PROMPT_DIR=.prompts
# Dynamic status: when true, uses the secondary model to generate a short
# real-time summary of what each tool call is doing, replacing the static hint.
# Requires SECONDARY_PROVIDER to be configured.
DYNAMIC_STATUS=false

# Observability endpoints (/metrics, /runs). Set OBSERVABILITY_TOKEN and send
# Authorization: Bearer <token> or X-Slack-Copilot-Agent-Admin-Token: <token>.
OBSERVABILITY_TOKEN=
# Development-only fallback for direct loopback requests without forwarded headers.
OBSERVABILITY_ALLOW_UNAUTHENTICATED=false

# GCP defaults and hints. Tool calls can override these per request.
GCLOUD_PATH=gcloud
GCP_PROJECT=my-project
GCP_NAMESPACE=my-namespace
GKE_CLUSTER=my-cluster
GKE_REGION=us-central1

# Kubernetes — kubectl direct access for pod/resource inspection.
KUBECTL_PATH=kubectl
K8S_DEFAULT_CONTEXT=
K8S_DEFAULT_CLUSTER=

# MiMo TTS — speech synthesis via MiMo-V2.5-TTS.
# Uses the same API key and token-plan endpoint as MiMo LLM by default.
# Set TTS_AUTO=true to have every agent reply also produce a voice message.
# TTS_DEFAULT_VOICE: 冰糖, 茉莉, 苏打, 白桦, Mia, Chloe, Milo, Dean
TTS_API_KEY=
TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts
TTS_AUTO=true
TTS_DEFAULT_VOICE=冰糖
TTS_DEFAULT_STYLE=

# Notion – Personal Access Token (PAT). Grants access to all pages visible to your account.
# Generate at: Notion Settings → My connections → Personal Access Tokens
NOTION_TOKEN=

# YouTrack
YOUTRACK_URL=
YOUTRACK_TOKEN=

# GitHub Actions / CI/CD
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# Luckin Coffee MCP. Copy a personal login token from https://open.lkcoffee.com/mcp.
LUCKIN_MCP_URL=https://gwmcp.lkcoffee.com/order/user/mcp
LUCKIN_MCP_TOKEN=

# Playwright MCP (optional). Start server: npx @playwright/mcp@latest --port 8931 --host 0.0.0.0 --headless
# Leave unset to disable browser automation tools entirely.
PLAYWRIGHT_MCP_URL=
PLAYWRIGHT_MCP_TOKEN=

# Web search. duckduckgo is the free default; searxng points to a local instance.
# Start local SearXNG: docker compose -f docker-compose.search.yml up -d
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:8097
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_CX=
WEB_SEARCH_SERPAPI_KEY=
WEB_SEARCH_SERPAPI_BASE_URL=https://serpapi.com/search.json

# Optional RAG semantic code search. Code questions use agentic search via
# grep, repo snapshots, and LSP tools by default. Enable this only when you
# want semantic recall as an additional hint source.
#
# Requires PostgreSQL with pgvector and an OpenAI-compatible embedding API.
# Start the local database with:
#   docker compose -f docker-compose.rag.yml up -d
RAG_ENABLED=false
# Durable operational storage: sessions, event inbox, runs, and reminders.
# RAG also uses this by default.
POSTGRES_DSN=postgres://slack_copilot:slack_copilot@localhost:5432/slack_copilot?sslmode=disable
# Shared connection ceiling used by all PostgreSQL stores unless a store-specific
# value below is set. Lower this when running multiple replicas.
POSTGRES_MAX_CONNS=
POSTGRES_SESSION_MAX_CONNS=
POSTGRES_RUNS_MAX_CONNS=
POSTGRES_REMINDER_MAX_CONNS=
POSTGRES_INBOX_MAX_CONNS=
RAG_POSTGRES_DSN=
RAG_POSTGRES_MAX_CONNS=
# Embedding provider. Any OpenAI-compatible /v1/embeddings endpoint works.
# Local Ollama:    http://localhost:11434/v1  (model: nomic-embed-text, dims: 768)
# SiliconFlow:     https://api.siliconflow.cn/v1  (model: BAAI/bge-m3, dims: 1024)
# OpenAI:          https://api.openai.com/v1  (model: text-embedding-3-small, dims: 1536)
RAG_EMBEDDING_BASE_URL=http://localhost:11434/v1
RAG_EMBEDDING_API_KEY=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMS=768
# Starts async workspace prewarming; rag-search still queues per-repo indexing on demand.
# Background indexing prewarms all workspace repos on a timer. Disabled by
# default; rag-search queues per-repo indexing on demand when called.
RAG_BACKGROUND_INDEX=false
RAG_INDEX_INTERVAL=5m
# Delay between embedding batches to reduce CPU pressure. Set to 0 for maximum
# throughput (e.g. cloud embedding providers). Default 200ms.
RAG_BATCH_DELAY=200ms

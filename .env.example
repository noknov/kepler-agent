# Server
HTTP_ADDR=:8080

# Slack HTTP Events API
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_BOT_USER_ID=
ALLOWED_SLACK_USERS=U11111111,U22222222
ALLOWED_SLACK_CHANNELS=

# LLM provider
LLM_PROVIDER=mimo
MIMO_PROTOCOL=anthropic
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5
MIMO_THINKING=disabled
# Set this only if you intentionally want shell env vars to disagree with .env.
ALLOW_ENV_MIXING=
# Set this to make .env override conflicting shell provider variables.
PREFER_DOTENV=

# Optional alternate providers.
LLM_PROTOCOL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# For Kimi For Coding / Claude Code-style agents, prefer:
# LLM_PROTOCOL=anthropic
# LLM_ANTHROPIC_FLAVOR=claude-code
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
# ANTHROPIC_MODEL=kimi-for-coding
LLM_ANTHROPIC_FLAVOR=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ALLOW_EXPERIMENTAL_CODING_ENDPOINT=
CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
API_TIMEOUT_MS=120000

MOONSHOT_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
KIMI_THINKING=enabled
MIMO_MAX_TOKENS=8192
MIMO_TEMPERATURE=0.2
MIMO_TIMEOUT=120s
KIMI_MAX_TOKENS=8192
KIMI_TEMPERATURE=0.2
KIMI_TIMEOUT=120s

# Workspace and sessions
WORKSPACE_ROOTS=/Users/shelton/Documents/wati
WORKSPACE_AUTO_FETCH=false
SESSION_DATA_DIR=.data/sessions
SESSION_MAX_MESSAGES=24
SESSION_MAX_TOOL_CHARS=20000
SESSION_MAX_THREAD_CHARS=6000
SESSION_MAX_SUMMARY_CHARS=2500
TOOL_COMMAND_TIMEOUT=30s
PROMPT_DIR=.prompts

# GCP defaults and hints. Tool calls can override these per request.
GCLOUD_PATH=gcloud
GCP_PROJECT=wati-gke
GCP_NAMESPACE=mt-dev-analytics
GKE_CLUSTER=mt-pubsub
GKE_REGION=asia-southeast1

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_VERSION=2022-06-28

# YouTrack
YOUTRACK_URL=
YOUTRACK_TOKEN=

# GitHub Actions / CI/CD
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=
